erDiagram
    USER ||--o{ QUIZ : creates
    USER ||--o{ SESSION : hosts

    QUIZ ||--o{ QUESTION : contains
    QUESTION ||--o{ OPTION : has

    QUIZ ||--o{ SESSION : used_for
    SESSION ||--|| SESSION_SETTING : configures
    SESSION ||--o{ PARTICIPANT : contains

    PARTICIPANT ||--o{ ATTEMPT : makes
    ATTEMPT ||--o{ ANSWER : contains

    ANSWER ||--o{ ANSWER_OPTION : selects
    OPTION ||--o{ ANSWER_OPTION : selected_as

    USER {
        uuid id PK
        varchar display_name
        enum role
        timestamp created_at
        timestamp updated_at
    }

    QUIZ {
        uuid id PK
        uuid creator_id FK
        varchar title
        text description
        enum status
        timestamp created_at
        timestamp updated_at
        timestamp published_at
    }

    QUESTION {
        uuid id PK
        uuid quiz_id FK
        enum type
        text content
        decimal points
        int time_limit_seconds
        int position
        timestamp created_at
        timestamp updated_at
    }

    OPTION {
        uuid id PK
        uuid question_id FK
        text content
        boolean is_correct
        int position
        timestamp created_at
        timestamp updated_at
    }

    SESSION {
        uuid id PK
        uuid quiz_id FK
        uuid host_id FK
        varchar pin
        enum mode
        enum status
        timestamp created_at
        timestamp started_at
        timestamp ended_at
    }

    SESSION_SETTING {
        uuid session_id PK, FK
        enum timer_mode
        boolean shuffle_questions
        boolean shuffle_answers
        boolean show_leaderboard
        boolean allow_skip_questions
        int participant_attempt_limit
        timestamp created_at
        timestamp updated_at
    }

    PARTICIPANT {
        uuid id PK
        uuid session_id FK
        uuid user_id FK
        varchar nickname
        enum status
        timestamp joined_at
        timestamp completed_at
    }

    ATTEMPT {
        uuid id PK
        uuid participant_id FK
        int attempt_number
        enum status
        timestamp started_at
        timestamp submitted_at
        decimal accuracy_points
        decimal max_accuracy_points
        int session_score
        int correct_count
        int incorrect_count
        int answered_count
        int total_questions
        int time_spent_ms
    }

    ANSWER {
        uuid id PK
        uuid attempt_id FK
        uuid question_id FK
        boolean is_correct
        decimal accuracy_points_awarded
        int session_score_awarded
        int response_time_ms
        timestamp answered_at
    }

    ANSWER_OPTION {
        uuid answer_id PK, FK
        uuid option_id PK, FK
    }
