erDiagram
    USERS ||--o{ QUIZZES : creates
    USERS ||--o{ SESSIONS : hosts
    USERS o|--o{ PARTICIPANTS : identifies

    QUIZZES ||--o{ QUESTIONS : contains
    QUESTIONS ||--o{ QUESTION_OPTIONS : has

    QUIZZES ||--o{ SESSIONS : used_for
    SESSIONS ||--|| SESSION_SETTINGS : configures
    SESSIONS ||--o{ PARTICIPANTS : contains

    PARTICIPANTS ||--o{ ATTEMPTS : makes
    ATTEMPTS ||--o{ ANSWERS : contains

    ANSWERS ||--o{ ANSWER_OPTIONS : selects
    QUESTION_OPTIONS ||--o{ ANSWER_OPTIONS : selected_as

    USERS {
        uuid id PK
        varchar display_name
        user_role role
        timestamptz created_at
        timestamptz updated_at
    }

    QUIZZES {
        uuid id PK
        uuid creator_id FK
        varchar title
        text description
        quiz_status status
        timestamptz published_at
        timestamptz created_at
        timestamptz updated_at
    }

    QUESTIONS {
        uuid id PK
        uuid quiz_id FK
        question_type type
        text content
        numeric points
        int time_limit_seconds
        int position
        timestamptz created_at
        timestamptz updated_at
    }

    QUESTION_OPTIONS {
        uuid id PK
        uuid question_id FK
        text content
        boolean is_correct
        smallint position
        timestamptz created_at
        timestamptz updated_at
    }

    SESSIONS {
        uuid id PK
        uuid quiz_id FK
        uuid host_id FK
        varchar pin
        session_mode mode
        session_status status
        timestamptz created_at
        timestamptz started_at
        timestamptz ended_at
    }

    SESSION_SETTINGS {
        uuid session_id PK, FK
        timer_mode timer_mode
        boolean shuffle_questions
        boolean shuffle_answers
        boolean show_leaderboard
        boolean allow_skip_questions
        smallint participant_attempt_limit
        timestamptz created_at
        timestamptz updated_at
    }

    PARTICIPANTS {
        uuid id PK
        uuid session_id FK
        uuid user_id FK
        varchar nickname
        participant_status status
        timestamptz joined_at
        timestamptz completed_at
    }

    ATTEMPTS {
        uuid id PK
        uuid participant_id FK
        smallint attempt_number
        attempt_status status
        timestamptz started_at
        timestamptz submitted_at
        numeric accuracy_points
        numeric max_accuracy_points
        int session_score
        int correct_count
        int incorrect_count
        int answered_count
        int total_questions
        bigint time_spent_ms
    }

    ANSWERS {
        uuid id PK
        uuid attempt_id FK
        uuid question_id FK
        boolean is_correct
        numeric accuracy_points_awarded
        int session_score_awarded
        bigint response_time_ms
        timestamptz answered_at
    }

    ANSWER_OPTIONS {
        uuid answer_id PK, FK
        uuid option_id PK, FK
    }
