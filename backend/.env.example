# Sao chép file này thành backend/.env rồi thay thông tin mẫu trên máy của bạn.
# File mẫu không chứa thông tin đăng nhập thật. Không commit backend/.env.
# Backend và các lệnh db:* đọc cấu hình HTTP/DB bên dưới.
# /ready kiểm tra DB; auth và token S07 chưa được triển khai.

# Máy chủ HTTP (đã triển khai)
# NODE_ENV: development (phát triển) | test (kiểm thử) | production (triển khai)
NODE_ENV=development
# Dùng 0.0.0.0 khi triển khai hoặc cho thiết bị khác truy cập API.
HOST=127.0.0.1
PORT=3002
# Các origin frontend cách nhau bằng dấu phẩy; không có dấu / cuối hoặc ký tự *.
FRONTEND_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Kết nối PostgreSQL (S04; dùng pg cho lớp truy cập dữ liệu)
# Ví dụ chạy local. Thay tên đăng nhập, mật khẩu và tên database cho phù hợp.
# Mã hóa URL các ký tự đặc biệt trong tên đăng nhập và mật khẩu.
# Với Supabase, lấy URI kết nối trong mục Connect của dự án.
# Dùng DB phát triển/kiểm thử để chạy migration và tạo dữ liệu mẫu.
DATABASE_URL=postgresql://postgres:replace_with_local_password@127.0.0.1:5432/qforge_dev
# Cấu hình demo hiện dùng disable (tắt TLS và xác minh chứng chỉ).
# Khi bật TLS có xác minh, đổi thành verify-full.
DATABASE_SSL_MODE=disable
# Pool và timeout dùng chung cho server và các lệnh DB.
DATABASE_POOL_MAX=10
DATABASE_CONNECTION_TIMEOUT_MS=10000
DATABASE_IDLE_TIMEOUT_MS=30000

# Seed dùng UUID Teacher cố định trong database/seeds, không cần cấu hình riêng.

# Thông tin xác thực người tham gia dạng khách (S07; đề xuất token ngẫu nhiên)
# Tạo secret trên máy, ví dụ: node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
# Dùng để băm token người tham gia bằng HMAC trước khi lưu vào DB.
PARTICIPANT_TOKEN_HASH_SECRET=
PARTICIPANT_TOKEN_TTL_SECONDS=86400

# Nam/Lâm sẽ bổ sung Socket.IO sau, gắn vào cùng máy chủ HTTP.
# Cấu hình riêng cho socket sẽ được thêm khi nhóm chốt contract.
